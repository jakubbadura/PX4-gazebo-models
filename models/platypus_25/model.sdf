<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="platypus_25">

    <!-- ==================== MAIN AIRFRAME / FUSELAGE ==================== -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- CG located 25% MAC (X = +0.15m ahead of trailing edge, Z = -0.01m) -->
        <pose>0.15 0 -0.01 0 0 0</pose>
        <!-- Operating mass: 18.0 kg (dry mass 15kg + fuel) -->
        <mass>18.0</mass>
        <inertia>
          <ixx>2.50</ixx>
          <ixy>0.0</ixy>
          <iyy>3.20</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>5.50</izz>
        </inertia>
      </inertial>

      <!-- Visual 3D Mesh: Platypus NG CAD model rotated so +X is forward, +Y is port -->
      <visual name="platypus_mesh">
        <pose>0 0 0 0 0 1.57079632679</pose>
        <geometry>
          <mesh>
            <uri>model://platypus_25/meshes/platypus.obj</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- Belly Skid / Runway Contact Collisions: Wide Twin Runners with Tail Clearance -->
      <!-- Left Skid Runner (Y = +0.22m, length 0.46m spanning across CG X = +0.15m) -->
      <collision name="left_belly_skid">
        <pose>0.22 0.22 -0.17 0 0 0</pose>
        <geometry>
          <box>
            <size>0.46 0.10 0.12</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.03</mu>
              <mu2>0.03</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Right Skid Runner (Y = -0.22m, length 0.46m spanning across CG X = +0.15m) -->
      <collision name="right_belly_skid">
        <pose>0.22 -0.22 -0.17 0 0 0</pose>
        <geometry>
          <box>
            <size>0.46 0.10 0.12</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.03</mu>
              <mu2>0.03</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Front Nose Guide Skid -->
      <collision name="nose_guide_skid">
        <pose>0.55 0 -0.17 0 0 0</pose>
        <geometry>
          <box>
            <size>0.22 0.16 0.12</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.03</mu>
              <mu2>0.03</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- ==================== SENSORS ==================== -->
      <!-- IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0003</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0003</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0003</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- NavSat / GPS Sensor -->
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>

      <!-- Barometer / Air Pressure Sensor -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
      </sensor>

      <!-- Magnetometer Sensor -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
      </sensor>

      <!-- FPV Nose Camera -->
      <sensor name="camera_front" type="camera">
        <pose>0.85 0 0.02 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30.0</update_rate>
        <camera>
          <horizontal_fov>1.92</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>5000</far>
          </clip>
        </camera>
      </sensor>

      <!-- Downward Nadir Camera -->
      <sensor name="camera_down" type="camera">
        <pose>0.15 0 -0.10 0 1.57079632679 0</pose>
        <always_on>1</always_on>
        <update_rate>15.0</update_rate>
        <camera>
          <horizontal_fov>1.40</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.5</near>
            <far>5000</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- Airspeed Pitot Probe Include -->
    <include>
      <uri>model://airspeed</uri>
      <pose>0.85 0 0.06 0 0 0</pose>
    </include>
    <joint name="airspeed_joint" type="fixed">
      <parent>base_link</parent>
      <child>airspeed::airspeed_link</child>
    </joint>

    <!-- ==================== 200N JET TURBINE ROTOR ==================== -->
    <link name="turbine_rotor">
      <!-- Mounted at tail X = -0.65m, aligned through CG height Z = -0.01m -->
      <pose>-0.65 0 -0.01 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0003</ixx>
          <iyy>0.0003</iyy>
          <izz>0.000003</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="turbine_joint" type="revolute">
      <parent>base_link</parent>
      <child>turbine_rotor</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ==================== LEFT ELEVON ==================== -->
    <link name="elevon_left">
      <pose>-0.50 0.45 0.01 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.004</ixx>
          <iyy>0.0005</iyy>
          <izz>0.004</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="elevon_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>elevon_left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.524</lower>
          <upper>0.524</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== RIGHT ELEVON ==================== -->
    <link name="elevon_right">
      <pose>-0.50 -0.45 0.01 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.004</ixx>
          <iyy>0.0005</iyy>
          <izz>0.004</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="elevon_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>elevon_right</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.524</lower>
          <upper>0.524</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== RUDDER (TWIN VERTICAL FINS) ==================== -->
    <link name="rudder">
      <pose>-0.50 0 0.18 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="rudder_joint" type="revolute">
      <parent>base_link</parent>
      <child>rudder</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.45</lower>
          <upper>0.45</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== AERODYNAMICS PLUGINS ==================== -->
    <!-- Main Delta Wing Left Half-Span (cp = +0.15m, +0.35m, 0.55m^2 area, roll damping Clp) -->
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.015</a0>
      <cla>4.80</cla>
      <cda>0.48</cda>
      <cma>0.0</cma>
      <alpha_stall>0.55</alpha_stall>
      <cla_stall>-2.80</cla_stall>
      <cda_stall>-0.80</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>0.15 0.35 0</cp>
      <area>0.55</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
    </plugin>

    <!-- Main Delta Wing Right Half-Span (cp = +0.15m, -0.35m, 0.55m^2 area, roll damping Clp) -->
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.015</a0>
      <cla>4.80</cla>
      <cda>0.48</cda>
      <cma>0.0</cma>
      <alpha_stall>0.55</alpha_stall>
      <cla_stall>-2.80</cla_stall>
      <cda_stall>-0.80</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>0.15 -0.35 0</cp>
      <area>0.55</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
    </plugin>

    <!-- Left Elevon Aerodynamics -->
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0>
      <cla>4.80</cla>
      <cda>0.30</cda>
      <cma>0.0</cma>
      <alpha_stall>0.55</alpha_stall>
      <cla_stall>-2.80</cla_stall>
      <cda_stall>-0.80</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.50 0.45 0.01</cp>
      <area>0.12</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>elevon_left_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.6</control_joint_rad_to_cl>
    </plugin>

    <!-- Right Elevon Aerodynamics -->
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0>
      <cla>4.80</cla>
      <cda>0.30</cda>
      <cma>0.0</cma>
      <alpha_stall>0.55</alpha_stall>
      <cla_stall>-2.80</cla_stall>
      <cda_stall>-0.80</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.50 -0.45 0.01</cp>
      <area>0.12</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>elevon_right_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.6</control_joint_rad_to_cl>
    </plugin>

    <!-- Left Vertical Fin Aerodynamics -->
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0>
      <cla>3.80</cla>
      <cda>0.20</cda>
      <cma>0.0</cma>
      <alpha_stall>0.45</alpha_stall>
      <cla_stall>-2.00</cla_stall>
      <cda_stall>-0.50</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.50 0.45 0.18</cp>
      <area>0.12</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <link_name>base_link</link_name>
      <control_joint_name>rudder_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.2</control_joint_rad_to_cl>
    </plugin>

    <!-- Right Vertical Fin Aerodynamics -->
    <plugin filename="gz-sim-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0>
      <cla>3.80</cla>
      <cda>0.20</cda>
      <cma>0.0</cma>
      <alpha_stall>0.45</alpha_stall>
      <cla_stall>-2.00</cla_stall>
      <cda_stall>-0.50</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-0.50 -0.45 0.18</cp>
      <area>0.12</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <link_name>base_link</link_name>
      <control_joint_name>rudder_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.2</control_joint_rad_to_cl>
    </plugin>

    <!-- ==================== ACTUATOR POSITION & MOTOR CONTROLLERS ==================== -->
    <!-- Left Elevon Servo (Channel 1 -> servo_0) -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>elevon_left_joint</joint_name>
      <sub_topic>servo_0</sub_topic>
      <p_gain>20.0</p_gain>
    </plugin>

    <!-- Right Elevon Servo (Channel 2 -> servo_1) -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>elevon_right_joint</joint_name>
      <sub_topic>servo_1</sub_topic>
      <p_gain>20.0</p_gain>
    </plugin>

    <!-- Twin Rudder Servo (Channel 5 -> servo_4) -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>rudder_joint</joint_name>
      <sub_topic>servo_4</sub_topic>
      <p_gain>20.0</p_gain>
    </plugin>

    <!-- 200N Jet Turbine Propulsion (Motor 1 -> command/motor_speed) -->
    <!-- Thrust = motorConstant * rotVelocity^2. At 1000 rad/s: 0.000200 * 1,000,000 = 200.0 N -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>turbine_joint</jointName>
      <linkName>turbine_rotor</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.25</timeConstantUp>
      <timeConstantDown>0.25</timeConstantDown>
      <maxRotVelocity>1000.0</maxRotVelocity>
      <motorConstant>0.000200</motorConstant>
      <momentConstant>0.0001</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>0.0</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

  </model>
</sdf>
