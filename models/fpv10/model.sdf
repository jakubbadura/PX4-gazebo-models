<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='fpv10'>
    <pose>0 0 0.15 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <!-- ==================== BASE LINK ==================== -->
    <link name="base_link">
      <inertial>
        <!-- AUW: ~2.4 kg (Body + electronics + 6S battery = ~2.3 kg; 4x rotors = 4x 0.025 kg) -->
        <!-- Easily adjustable: modify mass and ixx/iyy/izz below -->
        <mass>2.30</mass>
        <inertia>
          <ixx>0.025</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.025</iyy>
          <iyz>0</iyz>
          <izz>0.047</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay />

      <!-- Center Body (Carbon Frame Plates) -->
      <visual name="body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.24 0.09 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
          <specular>0.4 0.4 0.4 1.0</specular>
        </material>
      </visual>

      <!-- Battery Pack (6S LiPo / Li-Ion on top) -->
      <visual name="battery_visual">
        <pose>-0.02 0 0.035 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 0.05 0.045</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.5 0.0 1.0</ambient>
          <diffuse>0.9 0.55 0.0 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
        </material>
      </visual>

      <!-- Carbon Arms (450mm diagonal wheelbase) -->
      <!-- Arm 0: Front-Right (+X, -Y) -->
      <visual name="arm_0_visual">
        <pose>0.08 -0.08 0 0 0 -0.785398</pose>
        <geometry>
          <box>
            <size>0.20 0.022 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>

      <!-- Arm 1: Rear-Left (-X, +Y) -->
      <visual name="arm_1_visual">
        <pose>-0.08 0.08 0 0 0 -0.785398</pose>
        <geometry>
          <box>
            <size>0.20 0.022 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>

      <!-- Arm 2: Front-Left (+X, +Y) -->
      <visual name="arm_2_visual">
        <pose>0.08 0.08 0 0 0 0.785398</pose>
        <geometry>
          <box>
            <size>0.20 0.022 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>

      <!-- Arm 3: Rear-Right (-X, -Y) -->
      <visual name="arm_3_visual">
        <pose>-0.08 -0.08 0 0 0 0.785398</pose>
        <geometry>
          <box>
            <size>0.20 0.022 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>

      <!-- Motor Mount Stators (2812 class motors) -->
      <visual name="motor_mount_0">
        <pose>0.16 -0.16 0.01 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.017</radius>
            <length>0.022</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <visual name="motor_mount_1">
        <pose>-0.16 0.16 0.01 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.017</radius>
            <length>0.022</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <visual name="motor_mount_2">
        <pose>0.16 0.16 0.01 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.017</radius>
            <length>0.022</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <visual name="motor_mount_3">
        <pose>-0.16 -0.16 0.01 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.017</radius>
            <length>0.022</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <!-- Landing Stand / Skids -->
      <visual name="landing_pad_front">
        <pose>0.08 0 -0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.08 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.3 0.3 0.3 1.0</diffuse>
        </material>
      </visual>
      <visual name="landing_pad_rear">
        <pose>-0.08 0 -0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.08 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.3 0.3 0.3 1.0</diffuse>
        </material>
      </visual>

      <!-- Collision Elements -->
      <collision name="body_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.26 0.12 0.08</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <collision name="landing_collision_front">
        <pose>0.08 0 -0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.08 0.04</size>
          </box>
        </geometry>
      </collision>

      <collision name="landing_collision_rear">
        <pose>-0.08 0 -0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.08 0.04</size>
          </box>
        </geometry>
      </collision>

      <!-- Standard PX4 Sensors -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00087</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00087</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00087</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0063</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0063</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0068</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- ==================== FRONT FPV CAMERA ==================== -->
    <!-- Positioned at front nose, tilted up 20 degrees (-0.349 rad) for forward FPV flight -->
    <link name="camera_front_link">
      <pose relative_to="base_link">0.13 0 0.025 0 -0.349066 0</pose>
      <inertial>
        <mass>0.035</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <!-- Camera Case -->
      <visual name="cam_front_case">
        <geometry>
          <box>
            <size>0.02 0.025 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1.0</ambient>
          <diffuse>0.9 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
      <!-- Camera Lens -->
      <visual name="cam_front_lens">
        <pose>0.012 0 0 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.007</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.3 1.0</diffuse>
          <specular>0.9 0.9 0.9 1.0</specular>
        </material>
      </visual>
      <sensor name="camera_front" type="camera">
        <gz_frame_id>camera_front_link</gz_frame_id>
        <pose>0.015 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/camera_front/image_raw</topic>
        <camera>
          <horizontal_fov>1.74533</horizontal_fov> <!-- 100 deg wide FOV typical for FPV -->
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>8000</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_front_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_front_link</child>
    </joint>

    <!-- ==================== DOWNWARD CAMERA ==================== -->
    <!-- Positioned on belly, pointing straight down (+1.570796 rad pitch) -->
    <link name="camera_down_link">
      <pose relative_to="base_link">0 0 -0.025 0 1.570796 0</pose>
      <inertial>
        <mass>0.035</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <!-- Camera Case -->
      <visual name="cam_down_case">
        <geometry>
          <box>
            <size>0.02 0.025 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.2 0.8 1.0</ambient>
          <diffuse>0.1 0.3 0.9 1.0</diffuse>
        </material>
      </visual>
      <!-- Camera Lens -->
      <visual name="cam_down_lens">
        <pose>0.012 0 0 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.007</radius>
            <length>0.008</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.3 1.0</diffuse>
          <specular>0.9 0.9 0.9 1.0</specular>
        </material>
      </visual>
      <sensor name="camera_down" type="camera">
        <gz_frame_id>camera_down_link</gz_frame_id>
        <pose>0.015 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/camera_down/image_raw</topic>
        <camera>
          <horizontal_fov>1.570796</horizontal_fov> <!-- 90 deg FOV for downward ground view -->
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>8000</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_down_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_down_link</child>
    </joint>

    <!-- ==================== ROTOR 0 (Front Right - CCW) ==================== -->
    <link name="rotor_0">
      <pose relative_to="base_link">0.16 -0.16 0.025 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <iyy>0.00016</iyy>
          <izz>0.00016</izz>
        </inertia>
      </inertial>
      <!-- 10-inch Propeller Visual (0.254 m diameter) -->
      <visual name="rotor_0_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.254 0.022 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 0.8</ambient>
          <diffuse>0.3 0.3 0.3 0.8</diffuse>
        </material>
      </visual>
      <!-- Motor Bell Visual -->
      <visual name="motor_bell_0">
        <pose>0 0 -0.008 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.016</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1.0</ambient>
          <diffuse>0.9 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
      <collision name="rotor_0_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.127</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ==================== ROTOR 1 (Rear Left - CCW) ==================== -->
    <link name="rotor_1">
      <pose relative_to="base_link">-0.16 0.16 0.025 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <iyy>0.00016</iyy>
          <izz>0.00016</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.254 0.022 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 0.8</ambient>
          <diffuse>0.3 0.3 0.3 0.8</diffuse>
        </material>
      </visual>
      <visual name="motor_bell_1">
        <pose>0 0 -0.008 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.016</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1.0</ambient>
          <diffuse>0.9 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
      <collision name="rotor_1_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.127</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ==================== ROTOR 2 (Front Left - CW) ==================== -->
    <link name="rotor_2">
      <pose relative_to="base_link">0.16 0.16 0.025 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <iyy>0.00016</iyy>
          <izz>0.00016</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.254 0.022 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 0.8</ambient>
          <diffuse>0.3 0.3 0.3 0.8</diffuse>
        </material>
      </visual>
      <visual name="motor_bell_2">
        <pose>0 0 -0.008 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.016</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.8 1.0</ambient>
          <diffuse>0.1 0.1 0.9 1.0</diffuse>
        </material>
      </visual>
      <collision name="rotor_2_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.127</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ==================== ROTOR 3 (Rear Right - CW) ==================== -->
    <link name="rotor_3">
      <pose relative_to="base_link">-0.16 -0.16 0.025 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <iyy>0.00016</iyy>
          <izz>0.00016</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.254 0.022 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 0.8</ambient>
          <diffuse>0.3 0.3 0.3 0.8</diffuse>
        </material>
      </visual>
      <visual name="motor_bell_3">
        <pose>0 0 -0.008 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.016</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.8 1.0</ambient>
          <diffuse>0.1 0.1 0.9 1.0</diffuse>
        </material>
      </visual>
      <collision name="rotor_3_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.127</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ==================== MOTOR MODEL PLUGINS ==================== -->
    <!-- Calibrated for 10" prop: 30 N max thrust per motor at 1300 rad/s (~12400 RPM) -->
    <!-- motorConstant = 30.0 / (1300^2) = 1.775e-05 -->

    <!-- Motor 0 (Front-Right, CCW) -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1300.0</maxRotVelocity>
      <motorConstant>1.775e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>1.5e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- Motor 1 (Rear-Left, CCW) -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1300.0</maxRotVelocity>
      <motorConstant>1.775e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>1.5e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- Motor 2 (Front-Left, CW) -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1300.0</maxRotVelocity>
      <motorConstant>1.775e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>1.5e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- Motor 3 (Rear-Right, CW) -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1300.0</maxRotVelocity>
      <motorConstant>1.775e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>1.5e-04</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

  </model>
</sdf>
