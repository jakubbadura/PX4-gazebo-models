<sdf version='1.9'>
  <world name='dusniky'>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <scene>
      <ambient>0.8 0.8 0.85 1.0</ambient>
      <background>0.6 0.7 0.9 1.0</background>
      <grid>false</grid>
      <sky>
        <clouds>true</clouds>
      </sky>
      <shadows>true</shadows>
    </scene>

    <!-- Sun Lighting with Shadows -->
    <light name='sunUTC' type='directional'>
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.2</intensity>
      <direction>-0.3 0.4 -0.8</direction>
      <diffuse>1.0 0.98 0.92 1.0</diffuse>
      <specular>0.4 0.4 0.4 1.0</specular>
      <attenuation>
        <range>15000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <!-- Photorealistic Dusniky Airfield Terrain (LKDUSN) -->
    <include>
      <uri>model://dusniky_terrain</uri>
      <name>dusniky_terrain</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Real-World WGS84 GPS Coordinates of Letiste Dusniky (LKDUSN) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>50.412775</latitude_deg>
      <longitude_deg>14.198053</longitude_deg>
      <elevation>222.0</elevation>
    </spherical_coordinates>
  
    
    </world>
</sdf>
